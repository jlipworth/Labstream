------------------------ MODULE DownloadsStatusPhase ------------------------
(***************************************************************************)
(* DownloadRowStatusCaptionPolicy.phase for rows with no server            *)
(* preparation, as a function of the facts it reads, and the same          *)
(* function written out as a table.                                        *)
(*                                                                         *)
(* The table is the join between the model and the Swift.  TLC checks the  *)
(* ASSUME below whenever it loads DownloadsStatus, so the table cannot     *)
(* differ from PhaseOf.  DownloadsFormalModelStatusTests reads the table   *)
(* rows from this file and requires DownloadRowStatusCaptionPolicy.phase   *)
(* to give the same answer for each.  Change PhaseOf and the table         *)
(* together; keep one row per line in the form shown.                      *)
(*                                                                         *)
(* A row is <<lifecycle, zero, done, active, static, backend, phase>>:     *)
(*   lifecycle  DownloadLifecycle; the status is its derivedStatus         *)
(*   zero       the bytes the row shows are 0                              *)
(*   done       DownloadRecord.progress >= 1                               *)
(*   active     DownloadManager's isActive: activeJobs holds the key, or   *)
(*              the status is downloading                                  *)
(*   static     the route is static byte range (else forward-only)         *)
(*   backend    isBackendConfigured                                        *)
(*   phase      DownloadJobPhase, without its associated values            *)
(***************************************************************************)
\* MODELS: PMSKit/Sources/PMSKit/Downloads/DownloadRowStatusCaptionPolicy.swift
\* MODELS: PMSKit/Sources/PMSKit/Downloads/DownloadProgressDisplay.swift
EXTENDS DownloadsBase

PhaseOf(L, zero, done, active, static, backend) ==
    CASE L = "failed" -> "failed"
      [] L = "paused" -> "paused"
      [] L \in Playable -> "complete"
      [] L = "finalizing" -> "transferFinalizing"
      \* DownloadProgressDisplay.isTransferFinalizing: downloading with every byte reported.
      [] L = "transferring" /\ done -> "transferFinalizing"
      [] OTHER ->
            (IF zero
                THEN (IF active /\ static THEN "activeStaticZeroByteTransfer"
                      ELSE IF ~active /\ ~backend THEN "waitingForBackend"
                      ELSE IF active THEN "activeServerPrep"
                      ELSE "queued")
                ELSE (IF active THEN "activeTransfer" ELSE "inactiveTransfer"))

