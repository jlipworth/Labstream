scripts/ci-hygiene.local
# cloc scratch output
cloc-ignored.txt

# Per-developer signing (Apple Developer Team ID) — never commit
Signing.local.xcconfig
*.local.xcconfig

# CocoaPods / Carthage (unlikely, but just in case)
Pods/
Carthage/Build/

# Claude Code session data + agent worktrees (never commit) — but DO version skills
.claude/*
