<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Background audio (#17): music keeps playing when the app loses the
	     foreground. The rest of the Info.plist is still generated from build
	     settings (GENERATE_INFOPLIST_FILE=YES merges this file in); this key
	     lives here because the generator has no INFOPLIST_KEY for it. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>

	<!-- Export compliance (#appstore): the app uses only standard HTTPS/TLS
	     (exempt encryption), so declare non-exempt encryption = NO. This skips
	     the per-upload export-compliance question in App Store Connect. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>

	<!-- Local Network privacy prompt (#appstore): Plex servers are reached via
	     *.plex.direct hostnames that resolve to LAN/WAN IPs; accessing a local
	     address triggers the system Local Network prompt even over HTTPS. -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>VisionPlex connects to your Plex Media Server on your local network to browse and play your library.</string>

	<!-- App Transport Security (#33): the media-session proxy fronts PMS behind an
	     app-owned loopback origin, so AVFoundation loads the stream from
	     http://127.0.0.1:<port>/. ATS blocks cleartext loopback by default, and
	     that failure surfaces at AVPlayerItem load (not at proxy open), bypassing
	     the direct-URL fallback. NSAllowsLocalNetworking is the SCOPED exception
	     that permits cleartext to loopback/.local only — it does NOT relax ATS for
	     the public internet (never use NSAllowsArbitraryLoads). PMS itself is still
	     reached over HTTPS via *.plex.direct, unaffected by this key. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
</dict>
</plist>
