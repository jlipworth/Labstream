<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Background audio (#17): music keeps playing when the app loses the
	     foreground. The rest of the Info.plist is still generated from build
	     settings (GENERATE_INFOPLIST_FILE=YES merges this file in); this key
	     lives here because the generator has no INFOPLIST_KEY for it. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>

	<!-- CoreSpotlight deep links (#24): declare the search-result continuation
	     activity so taps on indexed library items reliably route back into the
	     app (handled via onContinueUserActivity in ContentView). -->
	<key>NSUserActivityTypes</key>
	<array>
		<string>com.apple.corespotlightitem</string>
	</array>

	<!-- Internal build traceability: defaults to "dev" from build settings, and
	     agent/CI builds can override with `scripts/build-version-args.sh` without
	     rewriting project files. -->
	<key>LabstreamBuildSlug</key>
	<string>$(LABSTREAM_BUILD_SLUG)</string>
	<key>LabstreamBuildDateUTC</key>
	<string>$(LABSTREAM_BUILD_DATE_UTC)</string>

	<!-- Export compliance (#appstore): the app does not implement proprietary or
	     non-standard cryptography. When encrypted transport is used, it relies on
	     standard Apple networking/TLS; loopback/LAN HTTP routes are cleartext.
	     Non-exempt encryption is declared NO only while this remains true. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>

	<!-- Local Network privacy prompt (#appstore): Plex/Jellyfin/Emby servers may be
	     reached at LAN addresses or .local hostnames; accessing a local address
	     triggers the system Local Network prompt even over HTTPS. Plex's
	     *.plex.direct hostnames can also resolve to LAN/WAN IPs. -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>Labstream connects to the Plex, Jellyfin, or Emby server you choose on your local network to browse, play, and download your personal media library.</string>

	<!-- App Transport Security (#33): the media-session proxy fronts media servers behind an
	     app-owned loopback origin, so AVFoundation loads the stream from
	     http://127.0.0.1:<port>/. ATS blocks cleartext loopback by default, and
	     that failure surfaces at AVPlayerItem load (not at proxy open), bypassing
	     the direct-URL fallback. NSAllowsLocalNetworking is the SCOPED exception
	     that permits the app-owned loopback HLS proxy and user-selected local/LAN
	     media-server URLs, including local HTTP for Plex/Jellyfin/Emby. It does
	     NOT relax ATS for arbitrary public-internet loads (never use
	     NSAllowsArbitraryLoads). -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
</dict>
</plist>
