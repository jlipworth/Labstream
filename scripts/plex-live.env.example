# Live PMS decision-probe credentials — COPY to scripts/plex-live.env (gitignored) and fill in.
# scripts/plex-live.env must NEVER be committed (it holds your token + real hostname).
#
#   cp scripts/plex-live.env.example scripts/plex-live.env
#   $EDITOR scripts/plex-live.env
#   ./scripts/live-decision-probe.sh
#   ./scripts/live-download-probe.sh   # prints original-vs-optimizer route for downloads
#   ./scripts/live-download-status-probe.sh  # read-only queue/progress snapshot

# Base URL of your PMS. Prefer the https *.plex.direct hostname (publicly-trusted cert) so
# URLSession.shared validates without a custom trust delegate, e.g.
#   https://<hash>.<machineId>.plex.direct:32400
# A bare-IP https://… works only if you accept its self-signed cert (the app doesn't by default).
PLEX_LIVE_SERVER=

# Your X-Plex auth token (a logged-in session has one; do not paste anyone else's).
PLEX_LIVE_TOKEN=

# The item to probe, e.g. /library/metadata/12345
PLEX_LIVE_METADATA_KEY=

# For the subtitle-burn probe (issue #75): an item that HAS an embedded image-based subtitle
# track (PGS/VOBSUB — e.g. a Blu-ray rip). Falls back to PLEX_LIVE_METADATA_KEY if unset.
#   ./scripts/live-subtitle-burn-probe.sh
# PLEX_LIVE_SUBTITLE_METADATA_KEY=/library/metadata/12345
# PLEX_LIVE_SUBTITLE_STREAM_ID=          # optional: pin a specific subtitle stream id

# For the browse + TV-hierarchy probe (issue #75):
#   ./scripts/live-plex-browse-probe.sh
# PLEX_LIVE_SECTION_KEY=1                          # a library section key (from /library/sections)
# PLEX_LIVE_SHOW_METADATA_KEY=/library/metadata/12345   # a TV SHOW item (bare ratingKey also OK)

# For the timeline/progress + session-stop probe (issue #75). ⚠️ TEST ACCOUNT ONLY — it writes a
# resume point on PLEX_LIVE_METADATA_KEY.
#   ./scripts/live-plex-timeline-probe.sh
# PLEX_LIVE_TIMELINE_OFFSET_SECONDS=120   # offset to report + read back

# Optional. Defaults shown.
# PLEX_LIVE_MAX_KBPS=200000   # Original quality ceiling (matches PlaybackController)
# PLEX_LIVE_MEDIA_INDEX=0
# PLEX_LIVE_PART_INDEX=0
# PLEX_LIVE_CLIENT_ID=visionplay-live-probe
# PLEX_LIVE_TITLE=VisionPlay Probe Optimize   # title for the optimize discovery probe (Phase 0)
