# Live PMS decision-probe credentials — COPY to scripts/plex-live.env (gitignored) and fill in.
# scripts/plex-live.env must NEVER be committed (it holds your token + real hostname).
#
#   cp scripts/plex-live.env.example scripts/plex-live.env
#   $EDITOR scripts/plex-live.env
#   ./scripts/live-decision-probe.sh

# Base URL of your PMS. Prefer the https *.plex.direct hostname (publicly-trusted cert) so
# URLSession.shared validates without a custom trust delegate, e.g.
#   https://<hash>.<machineId>.plex.direct:32400
# A bare-IP https://… works only if you accept its self-signed cert (the app doesn't by default).
PLEX_LIVE_SERVER=

# Your X-Plex auth token (a logged-in session has one; do not paste anyone else's).
PLEX_LIVE_TOKEN=

# The item to probe, e.g. /library/metadata/12345
PLEX_LIVE_METADATA_KEY=

# Optional. Defaults shown.
# PLEX_LIVE_MAX_KBPS=200000   # Original quality ceiling (matches PlaybackController)
# PLEX_LIVE_MEDIA_INDEX=0
# PLEX_LIVE_PART_INDEX=0
# PLEX_LIVE_CLIENT_ID=visionplex-live-probe
# PLEX_LIVE_TITLE=VisionPlex Probe Optimize   # title for the optimize discovery probe (Phase 0)
