# COPY to scripts/app-review-live.env (gitignored) and fill in. Never commit, print or paste these.
# The values are the App Review demo server and account from App Store Connect's Sign-In
# Information. `app-store-screenshots.py live drive` passes them to the opt-in live-catalog UI
# tests as TEST_RUNNER_ variables at run time; the tests skip cleanly when they are absent.
#
#   cp scripts/app-review-live.env.example scripts/app-review-live.env
#   chmod 600 scripts/app-review-live.env

LABSTREAM_LIVE_AUTH_SERVER=
LABSTREAM_LIVE_AUTH_USERNAME=
LABSTREAM_LIVE_AUTH_PASSWORD=

# Optional overrides for the catalog path the tests navigate (defaults shown).
# LABSTREAM_LIVE_LIBRARY=Movies
# LABSTREAM_LIVE_TITLE=Spring
