# COPY to scripts/jellyfin-live.env (gitignored) and fill in. Never commit live credentials.
#
#   cp scripts/jellyfin-live.env.example scripts/jellyfin-live.env
#   $EDITOR scripts/jellyfin-live.env
#   ./scripts/live-jellyfin-browse-timeline-probe.sh

JELLYFIN_SERVER_URL=
JELLYFIN_ACCESS_TOKEN=
JELLYFIN_USER_ID=

# A stable playable Movie/Episode/Video id used for metadata and timeline request proof.
JELLYFIN_LIVE_ITEM_ID=

# Optional. Setting this performs a distinct resume write/readback on a TEST ACCOUNT and restores
# the original offset before exit. Omit it for 2xx-only timeline proof with no intentional change.
# JELLYFIN_LIVE_TIMELINE_OFFSET_SECONDS=120

# Optional stable device id shown in the server's active-session UI.
# JELLYFIN_LIVE_DEVICE_ID=labstream-jellyfin-live-probe
