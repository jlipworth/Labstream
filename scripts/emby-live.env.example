# COPY to scripts/emby-live.env (gitignored) and fill in. Never commit live credentials.
#
#   cp scripts/emby-live.env.example scripts/emby-live.env
#   $EDITOR scripts/emby-live.env
#   ./scripts/live-emby-probe.sh

EMBY_LIVE_SERVER=
EMBY_LIVE_TOKEN=
EMBY_LIVE_USER_ID=
EMBY_LIVE_ITEM_ID=

# Optional PlaybackInfo ceiling.
# EMBY_LIVE_MAX_BITRATE=200000000

# Timeline acceptance MUTATES the configured item's resume point and is for a TEST ACCOUNT only.
# Both values are required for a PASS verdict. The probe reads the original offset, writes and
# reads back the distinct probe offset, then writes and verifies restoration of the original.
# EMBY_LIVE_ALLOW_TIMELINE_WRITE=1
# EMBY_LIVE_TIMELINE_OFFSET_SECONDS=120

# Optional stable device id shown in the server's active-session UI.
# EMBY_LIVE_DEVICE_ID=labstream-emby-live-probe
